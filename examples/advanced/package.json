{
  "name": "retrace-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:gleam": "gleam build && (cd viewer && gleam build)",
    "dev": "npm run build:gleam && vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "gleam build && node dev/build.mjs",
    "tauri": "tauri",
    "test": "playwright test --config ../../playwright.config.mjs",
    "viewer": "npm --prefix viewer run dev"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^8.3.4",
    "@playwright/test": "1.58.0"
  }
}
